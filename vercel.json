{
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "o" }], "destination": "/api/og" },
    { "source": "/opportunity/:slug", "destination": "/api/opportunity?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-opportunities.xml", "destination": "/api/sitemap" }
  ],
  "functions": {
    "api/og.js": { "includeFiles": "index.html" }
  }
}
